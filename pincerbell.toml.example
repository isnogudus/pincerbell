# pincerbell configuration. Copy to pincerbell.toml and adjust; a missing
# config file starts the gateway with these defaults and no apps.

# HTTP listen address. Put a TLS-terminating reverse proxy in front for
# anything beyond local testing. (The default avoids port 5000, which macOS
# occupies with its AirPlay receiver.)
#listen = "127.0.0.1:8300"

# Retry suppression: a delivered (event_id, app_id, pushkey) triple blocks
# repeat deliveries for this many seconds -- long enough for a homeserver's
# exponential-backoff retries, short enough that nothing accumulates. Set 0
# to disable. Count-only notifications (no event_id) are never suppressed.
#dedup_ttl_secs = 300

# Memory cap for the suppression cache (oldest entries evicted first).
#dedup_max_entries = 65536

# A notification for an app_id with no [apps] entry is logged and skipped by
# default. Setting this to true rejects such pushkeys instead, which makes
# the homeserver DELETE the pusher permanently -- enable only once the app
# list below is known-complete.
#reject_unknown_apps = false

# One table per app this gateway delivers for, keyed by the app_id that
# clients register their pusher with.
#
# kind = "log" writes notification metadata (never message content) to the
# log instead of contacting a push service -- for development and testing.
#
#[apps."org.example.app"]
#kind = "log"

# kind = "fcm" delivers via Firebase Cloud Messaging (HTTP v1 API). The
# pushkey is the FCM registration token. Messages are data-only and carry
# notification METADATA (event_id, room_id, type, sender, ...) -- never the
# event content; the app fetches the event itself. Requires a Google
# service-account JSON file with access to the Firebase project
# (roles/firebasemessaging.admin or equivalent).
#
#[apps."org.example.androidapp"]
#kind = "fcm"
#service_account_file = "/etc/pincerbell/service-account.json"
## project_id defaults to the service account's own; override if they differ:
#project_id = "my-project"
## API endpoint override (tests/proxies): defaults to https://fcm.googleapis.com
#api_root = "https://fcm.googleapis.com"

# kind = "apns" delivers via the Apple Push Notification service (HTTP/2,
# token-based auth). The pushkey is the APNs device token. Event pushes get
# a rewritable fallback alert (mutable-content: 1) plus the notification
# metadata as custom payload keys -- the app's notification service
# extension fetches the event and rewrites the alert; event content is
# never included. Count-only notifications become badge-only updates.
#
#[apps."org.example.iosapp"]
#kind = "apns"
#key_file = "/etc/pincerbell/AuthKey_ABC123DEFG.p8"
#key_id   = "ABC123DEFG"          # Apple key ID of the .p8 key
#team_id  = "TEAM123456"          # Apple developer team ID
#topic    = "org.example.iosapp"  # the app's bundle ID (apns-topic)
## sandbox = false                # api.sandbox.push.apple.com for dev builds
## default_alert_title = "New message"  # shown only if the app extension
##                                      # cannot rewrite the alert in time
## sound = "default"              # a push-rule sound tweak wins over this
