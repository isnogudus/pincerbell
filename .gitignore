/target

# Real deployment files -- only the .example templates are tracked. Keeps
# credentials (FCM service accounts, APNs .p8 keys) and site-specific
# network names out of the repo.
/pincerbell.toml
/compose.yaml
/compose.yml
*.p8
*service-account*.json

# The service key directory mounted into the container: everything in it is
# a credential, only the explanatory README is tracked.
/keys/*
!/keys/README.md
